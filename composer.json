{
    "name": "abduns/qrcode",
    "description": "A from-scratch, framework-agnostic QR Code generator for PHP 8.2+ with zero required runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "qr",
        "qr-code",
        "qrcode",
        "barcode",
        "iso-18004",
        "svg",
        "png"
    ],
    "authors": [
        {
            "name": "Abduns",
            "email": "abduns@example.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "ext-gd": "Required for the GD-backed PNG renderer."
    },
    "autoload": {
        "psr-4": {
            "Dunn\\QrCode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dunn\\QrCode\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php ./vendor/bin/pest",
        "stan": "phpstan analyse --memory-limit=512M",
        "fix": "php-cs-fixer fix",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "ci": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}